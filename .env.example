# Environment variables for the whatsapp-llama-bot Lambda.
# Set them in the Lambda console or with infrastructure/update_lambda_config.sh.

# WhatsApp Cloud API (Meta developer console)
WHATSAPP_TOKEN=your_whatsapp_token
PHONE_NUMBER_ID=your_phone_number_id
VERIFY_TOKEN=any_string_you_choose

# used for the market price fallback (anthropic_client.py)
ANTHROPIC_API_KEY=your_anthropic_key

# optional, the bot says weather is unavailable without it
OPENWEATHER_API_KEY=your_openweather_key

# data.gov.in key for AgMarkNet mandi prices
AGMARKNET_API_KEY=your_data_gov_in_key

# forecast table read by forecast_reply.py
PRICE_FORECAST_TABLE=kisaanmitra-price-forecasts
